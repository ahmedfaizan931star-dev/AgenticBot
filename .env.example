# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Public site URL (no trailing slash), used for OAuth redirects and origin checks ──
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Models (OpenAI-compatible endpoints; Gemini first, OpenRouter as fallback) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Search providers (any subset; at least one recommended) ──
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# ── Connectors ──
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts stored Google/GitHub tokens. If you lose it, users just reconnect.
CONNECTOR_ENCRYPTION_KEY=
# Google Cloud Console → Credentials → OAuth client (Web). Enable the Google Drive API.
# Authorized redirect URI: https://your-app.vercel.app/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google search (optional, off by default) ──
# Uses Gemini "Grounding with Google Search". Google requires showing its search suggestions (the app does).
# Keep your key on the FREE tier so it can never be billed; the app also caps daily use.
GOOGLE_GROUNDING_ENABLED=false
# Model that supports grounding on your key (defaults to GEMINI_MODEL).
GOOGLE_GROUNDING_MODEL=
GOOGLE_GROUNDING_DAILY_CAP=400
GOOGLE_GROUNDING_USER_DAILY=20

# ── MCP apps ──
# NEXT_PUBLIC_SITE_URL must be https for OAuth client-metadata sign-in; http works only for local development.
# TESTS ONLY, never in production: lets the MCP client reach http://127.0.0.1 servers.
# MCP_ALLOW_PRIVATE=1
